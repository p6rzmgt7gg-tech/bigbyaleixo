{
  "name": "big-by-aleixo",
  "private": true,
  "version": "1.0.0",
  "description": "BIG by Aleixo — Call Sheet → PDF. OCR e reconstrução de call sheets de produção broadcast, 100% no browser.",
  "type": "module",
  "scripts": {
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run ocr:assets",
    "dev": "vite",
    "prebuild": "npm run ocr:assets",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/por": "^1.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
